	(title_block
		(title "FZ1200R33KF2 plug-on gate driver rev B (open design)")
		(date "2026-11-09")
		(rev "B")
	)
	(lib_symbols)
	(text "FZ1200R33KF2 (3.3 kV / 1200 A, IHV 190x140) PLUG-ON GATE DRIVER rev B - 1SD418FI/1SP0635-class, no Power Integrations/CONCEPT parts"
		(exclude_from_sim no)
		(at 30 170 0)
		(effects
			(font
				(size 2.2 2.2)
			)
			(justify left bottom)
		)
		(uuid "10d6cb07-d300-5a39-af70-6488a8955056")
	)
	(text "Mounting: C/E/G M4 terminal holes and support hole at the 1SP0635 positions. MGJ6 barrier is functional (3 kVDC) - see README."
		(exclude_from_sim no)
		(at 30 194 0)
		(effects
			(font
				(size 2.2 2.2)
			)
			(justify left bottom)
		)
		(uuid "5a465140-338d-5265-a6a6-6d4a39989d60")
	)
	(text "Features: +15/-10 V gate drive, ~+/-15 A peak, separate RGon/RGoff, advanced active clamping (~2.7 kV), VCE(sat) short-circuit"
		(exclude_from_sim no)
		(at 30 182 0)
		(effects
			(font
				(size 2.2 2.2)
			)
			(justify left bottom)
		)
		(uuid "87c74b59-9d89-52d6-bc68-44027a265fc2")
	)
	(text "Interfaces: 15 V power on 1x4 2.54 mm header (J1) or JST-XH (J2); fiber command input HFBR-2521Z; fiber status output HFBR-1521Z."
		(exclude_from_sim no)
		(at 30 176 0)
		(effects
			(font
				(size 2.2 2.2)
			)
			(justify left bottom)
		)
		(uuid "e5faf8f3-74d2-5ddc-b497-cffea93a615d")
	)
	(text "detection with ~5 us blanking, supply UVLO, 1 s fault blocking time, status feedback. Isolated supply: Murata MGJ6D121510SC (COTS)."
		(exclude_from_sim no)
		(at 30 188 0)
		(effects
			(font
				(size 2.2 2.2)
			)
			(justify left bottom)
		)
		(uuid "fcea7a40-e18a-5d9e-bec0-314c6145e28a")
	)
