	(text "SECONDARY SIDE at IGBT emitter potential. COM_E = auxiliary emitter. VP15 = +15 V, VN10 = -10 V (MGJ6, unregulated +/-3 %/+/-5 %)."
		(exclude_from_sim no)
		(at 30 33 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "8c36522b-857c-5092-9dec-3e3ed9eb5aa9")
	)
	(text "R57 preloads the +15 V output above the MGJ6 10 % minimum load (otherwise it clamps at ~17 V). The -10 V output is loaded by U4/logic."
		(exclude_from_sim no)
		(at 30 38 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "af8ecb80-efc2-5bca-a631-0ae02ca9fe2b")
	)
	(text "VL5 is the logic rail = VN10 + 5 V; ALL logic, comparators and fiber parts are referenced to VN10."
