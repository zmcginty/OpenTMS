(version 1)
# Isolation coordination (IEC 61800-5-1 / IEC 60664-1, PD2, CTI>=600). Verify for your system voltage.
(rule "PRI_to_SEC_MGJ6_functional"
  (constraint clearance (min 8mm))
  (condition "(A.NetName == '/GND_P' || A.NetName == '/VIN_RAW' || A.NetName == '/VIN_F' || A.NetName == '/VIN_P' || A.NetName == '/VIN_M' || A.NetName == '/SYNC_P' || A.NetName == '/LED_P') && (B.NetName == '/ADJ_L' || B.NetName == '/BASE' || B.NetName == '/BLOCK' || B.NetName == '/CB' || B.NetName == '/CG' || B.NetName == '/CMD' || B.NetName == '/COM_E' || B.NetName == '/CONT' || B.NetName == '/DESAT' || B.NetName == '/DREF' || B.NetName == '/DSD' || B.NetName == '/GATE' || B.NetName == '/GATE_EN' || B.NetName == '/GOFF_A' || B.NetName == '/GOFF_B' || B.NetName == '/GON_A' || B.NetName == '/GON_B' || B.NetName == '/LED_F' || B.NetName == '/OH' || B.NetName == '/OL' || B.NetName == '/OUT_A' || B.NetName == '/OUT_B' || B.NetName == '/READY' || B.NetName == '/REF_UV' || B.NetName == '/RX_F' || B.NetName == '/RX_OUT' || B.NetName == '/TMR' || B.NetName == '/TX_A' || B.NetName == '/TX_K' || B.NetName == '/UVS' || B.NetName == '/VL5' || B.NetName == '/VN10' || B.NetName == '/VP15' || B.NetName == '/nDESAT' || B.NetName == '/nGATE' || B.NetName == '/COLL' || B.NetName == '/ACK2' || B.NetName == '/ACK3' || B.NetName == '/ACK4' || B.NetName == '/DS2' || B.NetName == '/DS3' || B.NetName == '/ACK1' || B.NetName == '/CLMP' || B.NetName == '/DS1' || B.NetName == '/DS_R')"))
(rule "COLL_to_LV_secondary"
  (constraint clearance (min 16mm))
  (condition "A.NetName == '/COLL' && (B.NetName == '/ADJ_L' || B.NetName == '/BASE' || B.NetName == '/BLOCK' || B.NetName == '/CB' || B.NetName == '/CG' || B.NetName == '/CMD' || B.NetName == '/COM_E' || B.NetName == '/CONT' || B.NetName == '/DESAT' || B.NetName == '/DREF' || B.NetName == '/DSD' || B.NetName == '/GATE' || B.NetName == '/GATE_EN' || B.NetName == '/GOFF_A' || B.NetName == '/GOFF_B' || B.NetName == '/GON_A' || B.NetName == '/GON_B' || B.NetName == '/LED_F' || B.NetName == '/OH' || B.NetName == '/OL' || B.NetName == '/OUT_A' || B.NetName == '/OUT_B' || B.NetName == '/READY' || B.NetName == '/REF_UV' || B.NetName == '/RX_F' || B.NetName == '/RX_OUT' || B.NetName == '/TMR' || B.NetName == '/TX_A' || B.NetName == '/TX_K' || B.NetName == '/UVS' || B.NetName == '/VL5' || B.NetName == '/VN10' || B.NetName == '/VP15' || B.NetName == '/nDESAT' || B.NetName == '/nGATE')"))
(rule "HV_to_LV_secondary"
  (constraint clearance (min 8mm))
  (condition "(A.NetName == '/COLL' || A.NetName == '/ACK2' || A.NetName == '/ACK3' || A.NetName == '/ACK4' || A.NetName == '/DS2' || A.NetName == '/DS3') && (B.NetName == '/ADJ_L' || B.NetName == '/BASE' || B.NetName == '/BLOCK' || B.NetName == '/CB' || B.NetName == '/CG' || B.NetName == '/CMD' || B.NetName == '/COM_E' || B.NetName == '/CONT' || B.NetName == '/DESAT' || B.NetName == '/DREF' || B.NetName == '/DSD' || B.NetName == '/GATE' || B.NetName == '/GATE_EN' || B.NetName == '/GOFF_A' || B.NetName == '/GOFF_B' || B.NetName == '/GON_A' || B.NetName == '/GON_B' || B.NetName == '/LED_F' || B.NetName == '/OH' || B.NetName == '/OL' || B.NetName == '/OUT_A' || B.NetName == '/OUT_B' || B.NetName == '/READY' || B.NetName == '/REF_UV' || B.NetName == '/RX_F' || B.NetName == '/RX_OUT' || B.NetName == '/TMR' || B.NetName == '/TX_A' || B.NetName == '/TX_K' || B.NetName == '/UVS' || B.NetName == '/VL5' || B.NetName == '/VN10' || B.NetName == '/VP15' || B.NetName == '/nDESAT' || B.NetName == '/nGATE')"))
(rule "HV_chain_internal"
  (constraint clearance (min 1.5mm))
  (condition "(A.NetName == '/COLL' || A.NetName == '/ACK2' || A.NetName == '/ACK3' || A.NetName == '/ACK4' || A.NetName == '/DS2' || A.NetName == '/DS3') && (B.NetName == '/COLL' || B.NetName == '/ACK2' || B.NetName == '/ACK3' || B.NetName == '/ACK4' || B.NetName == '/DS2' || B.NetName == '/DS3' || B.NetName == '/ACK1' || B.NetName == '/CLMP' || B.NetName == '/DS1' || B.NetName == '/DS_R')"))
