		(uuid "7aac5a39-9272-4080-93f6-77cc134dc2c2")
	)
	(text "FIRE_AND_ENABLE = (RAMP > FIRE_THRESHOLD) AND (ENABLE_IN > 1.35V).  ENABLE_IN low/floating = NO GATE PULSES"
